# Copy to .env (Bun loads it automatically) or export these variables in the unit that launches the channel.
# Placeholders only.

# --- Required: shared secret every client sends as "Authorization: Bearer <key>"
QG_CHANNEL_KEY=change-me
# QG_CHANNEL_KEY_FILE=/path/to/file-containing-the-key   # alternative to QG_CHANNEL_KEY

# --- HTTP server
QG_CHANNEL_PORT=8098
QG_CHANNEL_HOST=127.0.0.1          # use 0.0.0.0 only behind a reverse proxy / VPN you trust
QG_CHANNEL_STATE=~/.local/state/qg # outbox, read/answered/pushed marks, JSONL log
QG_OUTBOX_MAX=300                  # messages kept for replay (?since=0)
QG_REPLY_TIMEOUT_S=900             # how long an HTTP caller waits for the QG before getting a placeholder

# --- Who speaks as the user (trust="user"). Any other sender is treated as data.
QG_USER_SENDERS=panel,voice,phone

# --- Phone push through ntfy (optional; leave QG_NTFY_URL empty to disable)
QG_NTFY_URL=https://ntfy.example.com
QG_NTFY_TOPIC=your-private-topic
QG_NTFY_TOKEN=                     # write-only access token if the topic is protected
QG_NTFY_CLICK=                     # URL template opened on tap, "{id}" is replaced by the message id

# --- Urgency policy
QG_NORMAL_DELAY_MIN=10             # unread `normal` message -> one push after this delay
QG_QUESTION_REMINDER_MIN=45        # question read but unanswered -> one reminder after this delay
QG_POLICY_TICK_S=15                # how often the policy is evaluated
